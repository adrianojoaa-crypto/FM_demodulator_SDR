import matplotlib.pyplot as plt
import numpy as np
from scipy.signal import freqz

# Parameters
M_vals = np.arange(20, 101, 20)
w_c = np.pi / 20
h_matrix = np.zeros((len(M_vals), 101))

for index, M in enumerate(M_vals):
    n = np.arange(M + 1)
    alpha = M / 2
    
    # Hamming Window
    w = 0.54 - 0.46 * np.cos(2 * np.pi * n / M)

    h_lp = (w_c/np.pi) * np.sinc((w_c/np.pi) * (n - alpha))
    
    h = h_lp * w
    h_matrix[index, :len(h)] = h

# Magnitude Plot
fig, axes = plt.subplots(5, 1, figsize=(10, 15), sharex=True)
fig.suptitle('Magnitude Response (FIR Hamming)', fontsize=16)

for i, M in enumerate(M_vals):
    w_freq, H = freqz(h_matrix[i, :M+1], worN=8000)
    mag = 20 * np.log10(np.abs(H) + 1e-10) 
    
    axes[i].plot(w_freq / np.pi, mag, color=f'C{i}')
    axes[i].set_title(f'M = {M}')
    axes[i].set_ylabel('Mag (dB)')
    axes[i].set_ylim([-100, 5])
    axes[i].axvline(w_c / np.pi, color='black', linestyle='--', alpha=0.5)
    axes[i].grid(True, alpha=0.3)

axes[-1].set_xlabel(r'Normalized Frequency ($\times\pi$ rad/sample)')
plt.tight_layout(rect=[0, 0.03, 1, 0.95])
plt.show()

# Phase Plot (Using UNWRAP)
fig_p, axes_p = plt.subplots(5, 1, figsize=(10, 15), sharex=True)
fig_p.suptitle('Linear Phase Response (Unwrapped)', fontsize=16)

for i, M in enumerate(M_vals):
    w_freq, H = freqz(h_matrix[i, :M+1], worN=8000)
    # UNWRAP to avoid distortion (np.angle)
    phase = np.unwrap(np.angle(H)) 
    
    axes_p[i].plot(w_freq / np.pi, phase, color=f'C{i}')
    axes_p[i].set_title(f'M = {M}')
    axes_p[i].set_ylabel('Phase (rad)')
    axes_p[i].axvline(w_c / np.pi, color='black', linestyle='--', alpha=0.5)
    axes_p[i].set_yticks([-4*np.pi, -3*np.pi, -2*np.pi, -np.pi, 0, np.pi])
    axes_p[i].set_yticklabels(['-4$\pi$','-3$\pi$','-2$\pi$','$-\pi$', '0', '$\pi$'])
    axes_p[i].grid(True, alpha=0.3)

axes_p[-1].set_xlabel(r'Normalized Frequency ($\times\pi$ rad/sample)')
plt.tight_layout(rect=[0, 0.03, 1, 0.95])
plt.show()
